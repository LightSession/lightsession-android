<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.sample.lightsession.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Lightsessionandroid">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Reached from MainActivity, so it is not a launcher entry. It was declared as one,
             which put a second icon for this app in the launcher and offered a mid-flow screen as
             a way to start it — and starting there means the flow the SDK records has no
             beginning. Not exported either: nothing outside this app has business opening it. -->
        <activity
            android:name="com.sample.lightsession.SecondActivity"
            android:exported="false" />
        <activity
            android:name="com.sample.lightsession.ComposeActivity"
            android:exported="false" />
        <activity
            android:name="com.sample.lightsession.ComposeWithNavigationActivity"
            android:exported="false" />
    </application>

</manifest>